{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node",
    "outDir": "dist/cjs",
    "noEmit": false,
    "declaration": false,
    "allowImportingTsExtensions": false,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": false
  },
  "include": ["src"]
}
